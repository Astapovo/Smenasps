{
  "id": "./index.html",
  "name": "SmenaSps — Оперативный журнал смены и база знаний v1.1",
  "short_name": "SmenaSps",
  "version": "1.1.0",
  "description": "Автономный оперативный журнал смены, учёт сбоев, база знаний, конструктор мульти-чеклистов обхода и облачная синхронизация через Google Таблицы (Offline-First PWA)",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0E1316",
  "theme_color": "#F2F4F3",
  "lang": "ru",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://astapovo.github.io/Smenasps/manifest.json"
    }
  ],
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Новая запись сбоя",
      "short_name": "Сбой",
      "description": "Зафиксировать сбой в журнале смены",
      "url": "./index.html?action=new-incident",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "База знаний",
      "short_name": "Знания",
      "description": "Регламенты и проверенные решения",
      "url": "./index.html?action=kb",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Смена и обход",
      "short_name": "Смена",
      "description": "Передача смены, задачи и чек-лист обхода",
      "url": "./index.html?action=checklists",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Справка и обновления",
      "short_name": "Справка",
      "description": "Руководство и проверка новых версий на GitHub",
      "url": "./index.html?action=help",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
